{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "resolveJsonModule": true,
    "declaration": true
  },
  "include": ["shared/**/*.ts", "dashboard/**/*.ts", "dashboard/**/*.tsx"],
  "exclude": ["node_modules", "dist", "capabilities"]
}
