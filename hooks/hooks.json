{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\\hooks\\run-hook.cmd\"",
            "async": true,
            "env": {
              "CAPABILITIES_DIR": "${HOME}\\.claude\\capabilities",
              "PORT": "58288"
            }
          }
        ]
      }
    ]
  }
}
